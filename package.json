{
  "name": "gaudenzi-guitars-site",
  "version": "0.1.0",
  "private": true,
  "description": "Sito Gaudenzi Guitars – liuteria a Cattolica (Vue 3 + Vite, pre-renderizzato con vite-ssg)",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite-ssg build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.{scss,vue}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run test && npm run build",
    "check:dist": "node scripts/check-dist.mjs",
    "memory:snapshot": "node scripts/memory.mjs snapshot"
  },
  "dependencies": {
    "@google/model-viewer": "4.4.0",
    "@unhead/vue": "3.4.3",
    "three": "0.183.2",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "sass-embedded": "^1.106.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.3.5",
    "vite-ssg": "^28.3.0",
    "vitest": "^5.0.5",
    "wrangler": "4.149.0"
  }
}
